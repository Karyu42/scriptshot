[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="player_bullet"
2d_physics/layer_4="enemy_bullet"
2d_physics/layer_5="world"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_interpolation=true
common/physics_jitter_fix=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0784314, 0.0862745, 0.109804, 1)
